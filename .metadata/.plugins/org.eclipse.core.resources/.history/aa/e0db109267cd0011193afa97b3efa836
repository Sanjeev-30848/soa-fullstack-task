
package com.klef.soa.exam.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.klef.soa.exam.entity.CrudEntity;
import com.klef.soa.exam.repository.CrudRepository;

@Service
public class CrudServiceImpl implements CrudService {

    @Autowired
    private CrudRepository repository;

    @Override
    public String addFood(CrudEntity crudEntity) {
        repository.save(crudEntity);
        return "Food Added Successfully";
    }

    @Override
    public List<CrudEntity> displayFoods() {
        return repository.findAll();
    }

    @Override
    public String deleteFood(int id) {
        Optional<CrudEntity> optionalUser =
                repository.findById(id);

        if (optionalUser.isPresent()) {
            repository.delete(optionalUser.get());
            return "Food ID Deleted Successfully";
        } else {
            return "Food ID Not Found to Delete";
        }
    }

    @Override
    public String updateFood(int id, CrudEntity crudEntity) {

        Optional<CrudEntity> optionalFood =
                repository.findById(id);

        if (optionalFood.isPresent()) {

            CrudEntity food = optionalFood.get();

            food.setOrderCode(crudEntity.getOrderCode());
            food.setRestaurantName(crudEntity.getRestaurantName());
            food.setDeliveryFee(crudEntity.getDeliveryFee());
            food.setDelivered(crudEntity.getDelivered());

            repository.save(food);

            return "Food Updated Successfully";
        } else {
            return "Food ID Not Found";
        }
    }

    @Override
    public Optional<CrudEntity> displayFoodById(int id) {
        return repository.findById(id);
    }
}
